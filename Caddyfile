# Caddy auto-provisions and renews Let's Encrypt certificates for both domains — no certbot,
# no manual renewal cron. WEB_DOMAIN/API_DOMAIN come from the compose file's environment.
# Requires both domains' DNS A records to already point at this server's public IP, and ports
# 80 + 443 reachable from the internet (Caddy needs 80 for the ACME HTTP challenge).

{$WEB_DOMAIN} {
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	reverse_proxy api:4000
}
