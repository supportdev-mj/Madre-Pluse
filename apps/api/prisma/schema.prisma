// Madre Pulse — Prisma schema.
// Grows incrementally, one vertical slice at a time (see docs/MANAGEMENT.md).
// Slice 0: Organization / User / Membership. Slice 1: + RefreshToken. Slice 2: + Client / Project.
// Slice 3: + Task. Slice 6: + Subtask / TaskDependency.
// Slice 7: + Comment / Attachment / TaskActivity. Slice 8: + TimeEntry.
// Slice 9: + Notification. Slice 10: + ReopenRequest.
// Slice 11: + Task.completedAt (set automatically on DONE transitions, used by the dashboard).
// Slice 14: Task.assigneeId replaced by TaskAssignment (many-to-many) — multiple collaborators per task.
// Slice 15: Subtask.assigneeId — per-person ownership of a piece of a shared task.
// Slice 16: BlockerReport — a trackable "I'm blocked" flag, notifies ADMIN/MANAGER, resolvable.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  NEW_COMMENT
  TASK_DUE_SOON
  REOPEN_REQUESTED
  REOPEN_APPROVED
  REOPEN_REJECTED
  BLOCKER_REPORTED
  BLOCKER_RESOLVED
}

enum ReopenRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BlockerReportStatus {
  OPEN
  RESOLVED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships   Membership[]
  clients       Client[]
  projects      Project[]
  tasks         Task[]
  notifications Notification[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  initials     String
  avatarColor  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           Membership[]
  refreshTokens         RefreshToken[]
  taskAssignments       TaskAssignment[]
  subtaskAssignments    Subtask[]       @relation("SubtaskAssignee")
  createdTasks          Task[]          @relation("TaskCreator")
  comments              Comment[]
  attachments           Attachment[]
  taskActivities        TaskActivity[]
  timeEntries           TimeEntry[]
  notifications         Notification[]
  reopenRequestsMade    ReopenRequest[] @relation("ReopenRequester")
  reopenRequestsHandled ReopenRequest[] @relation("ReopenReviewer")
  blockerReportsMade    BlockerReport[] @relation("BlockerReporter")
  blockerReportsHandled BlockerReport[] @relation("BlockerResolver")

  @@map("users")
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Membership {
  id     String           @id @default(cuid())
  userId String
  orgId  String
  role   Role             @default(USER)
  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

model Client {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("clients")
}

model Project {
  id          String        @id @default(cuid())
  orgId       String
  clientId    String?
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks  Task[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([clientId])
  @@map("projects")
}

model Task {
  id          String       @id @default(cuid())
  orgId       String
  projectId   String?
  createdById String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User         @relation("TaskCreator", fields: [createdById], references: [id])

  assignments    TaskAssignment[]
  subtasks       Subtask[]
  dependencies   TaskDependency[] @relation("DependentTask")
  dependents     TaskDependency[] @relation("BlockingTask")
  comments       Comment[]
  attachments    Attachment[]
  activities     TaskActivity[]
  timeEntries    TimeEntry[]
  notifications  Notification[]
  reopenRequests ReopenRequest[]
  blockerReports BlockerReport[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([projectId])
  @@map("tasks")
}

// Slice 14: many-to-many task collaborators, replacing the old single Task.assigneeId.
// Every assignee has equal edit rights and gets notified the same way the sole assignee used to.
model TaskAssignment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignments")
}

// Slice 15: Subtask.assigneeId — the individual owner doing that piece of work,
// so effort on a multi-assignee task is visible per person. Must be one of the
// parent Task's current assignees (see SubtasksService); purely informational,
// doesn't narrow who can toggle/edit the subtask (see task-permissions.ts).
model Subtask {
  id         String   @id @default(cuid())
  taskId     String
  assigneeId String?
  title      String
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User? @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([assigneeId])
  @@map("subtasks")
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("attachments")
}

enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
}

model TaskActivity {
  id        String           @id @default(cuid())
  taskId    String
  actorId   String
  type      TaskActivityType
  message   String
  createdAt DateTime         @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId])
  @@map("task_activities")
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  minutes   Int
  note      String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("time_entries")
}

model Notification {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  taskId    String?
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([orgId])
  @@map("notifications")
}

model ReopenRequest {
  id            String              @id @default(cuid())
  taskId        String
  requestedById String
  reason        String
  status        ReopenRequestStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ReopenRequester", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("ReopenReviewer", fields: [reviewedById], references: [id])

  @@index([taskId])
  @@map("reopen_requests")
}

// Slice 16: a lightweight, trackable "I'm blocked" flag — free-text reason, not tied to a
// formal TaskDependency link. ADMIN/MANAGER are notified when one is raised and can resolve
// it; the reporter is notified back on resolution. Raisable by anyone with edit rights on the
// task (assertCanModifyTask), same as reopen requests.
model BlockerReport {
  id             String              @id @default(cuid())
  taskId         String
  reportedById   String
  reason         String
  status         BlockerReportStatus @default(OPEN)
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reportedBy User  @relation("BlockerReporter", fields: [reportedById], references: [id])
  resolvedBy User? @relation("BlockerResolver", fields: [resolvedById], references: [id])

  @@index([taskId])
  @@map("blocker_reports")
}
