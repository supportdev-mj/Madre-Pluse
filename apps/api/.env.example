# Copy to .env for local (non-docker) development.
# When running via `docker compose`, DATABASE_URL/REDIS_URL/S3_ENDPOINT are overridden by docker-compose.yml.
#
# For a production server: copy to apps/api/.env.production instead (see docker-compose.prod.yml
# at the repo root, and its usage notes there) — same variables, but with real values: strong
# random JWT secrets, a real S3-compatible bucket (not MinIO — see docker-compose.prod.yml's
# comments for why), real SMTP credentials, NODE_ENV=production, and CORS_ORIGIN set to the
# real https://<WEB_DOMAIN>.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://madrepulse:madrepulse@localhost:5432/madrepulse
REDIS_URL=redis://localhost:6379

# Filled in during Slice 1 (auth):
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Filled in during Slice 7 (attachments). S3_ENDPOINT is what the API server uses to
# reach storage (the Docker-internal MinIO hostname when running via compose).
# S3_PUBLIC_ENDPOINT is baked into presigned download URLs, so it must be a host the
# *browser* can reach — always localhost in dev, even when the API itself talks to
# MinIO over the Docker network.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=madrepulse-attachments
S3_ACCESS_KEY=madrepulse
S3_SECRET_KEY=madrepulse123
AWS_REGION=us-east-1

# Filled in during Slice 9 (notifications):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@madrepulse.local

# Filled in during Slice 19 (Google Meet integration, first step of meeting-notes-to-tasks).
# Get GOOGLE_CLIENT_ID/SECRET from a Google Cloud OAuth 2.0 Client ID (Web application type) —
# add GOOGLE_REDIRECT_URI to that client's "Authorized redirect URIs" exactly as written here.
# Until these are set, "Connect Google Workspace" in Settings returns a clear "not configured"
# error rather than crashing — same pattern as SMTP_HOST above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback
# 32 random bytes, base64-encoded — e.g. `openssl rand -base64 32`. Encrypts the Google refresh
# token at rest (a real secret we must decrypt and reuse later, unlike hashed auth tokens
# elsewhere). Required before anyone can connect Google Workspace; not optional like the above.
TOKEN_ENCRYPTION_KEY=

CORS_ORIGIN=http://localhost:3000
