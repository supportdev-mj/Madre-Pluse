# Copy to .env.prod and fill in real values. Used by docker-compose.prod.yml for both container
# credentials (Postgres) and Caddy's domain routing — NOT read by the app code itself (that's
# apps/api/.env.production, see its own .env.example for the full list).

POSTGRES_USER=madrepulse
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=madrepulse

# Must already have DNS A records pointing at this server before first `docker compose up` —
# Caddy requests a Let's Encrypt cert for each on startup and will fail if the domain doesn't
# resolve here yet.
WEB_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
