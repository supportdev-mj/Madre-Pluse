# Copy to .env for local (non-docker) development.
# When running via `docker compose`, DATABASE_URL/REDIS_URL/S3_ENDPOINT are overridden by docker-compose.yml.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://madrepulse:madrepulse@localhost:5432/madrepulse
REDIS_URL=redis://localhost:6379

# Filled in during Slice 1 (auth):
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Filled in during Slice 7 (attachments). S3_ENDPOINT is what the API server uses to
# reach storage (the Docker-internal MinIO hostname when running via compose).
# S3_PUBLIC_ENDPOINT is baked into presigned download URLs, so it must be a host the
# *browser* can reach — always localhost in dev, even when the API itself talks to
# MinIO over the Docker network.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=madrepulse-attachments
S3_ACCESS_KEY=madrepulse
S3_SECRET_KEY=madrepulse123
AWS_REGION=us-east-1

# Filled in during Slice 9 (notifications):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@madrepulse.local

CORS_ORIGIN=http://localhost:3000
