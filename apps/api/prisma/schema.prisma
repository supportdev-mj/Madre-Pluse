// Madre Pulse — Prisma schema.
// Grows incrementally, one vertical slice at a time (see docs/MANAGEMENT.md).
// Slice 0: Organization / User / Membership. Slice 1: + RefreshToken. Slice 2: + Client / Project.
// Slice 3: + Task. Slice 6: + Subtask / TaskDependency.
// Slice 7: + Comment / Attachment / TaskActivity. Slice 8: + TimeEntry.
// Slice 9: + Notification. Slice 10: + ReopenRequest.
// Slice 11: + Task.completedAt (set automatically on DONE transitions, used by the dashboard).
// Slice 14: Task.assigneeId replaced by TaskAssignment (many-to-many) — multiple collaborators per task.
// Slice 15: Subtask.assigneeId — per-person ownership of a piece of a shared task.
// Slice 16: BlockerReport — a trackable "I'm blocked" flag, notifies ADMIN/MANAGER, resolvable.
// Slice 19: GoogleIntegration — per-org Google Workspace OAuth connection (Meet transcripts, step 1
// of meeting-notes-to-tasks; MeetingNote/TaskDraft models land in a later slice once this is wired up).
// Slice 20: LlmSettings — one platform-wide LLM API key (superadmin-managed), step 2 of the same pipeline.
// Slice 18: User.isSuperAdmin (platform-wide, independent of org Role) + Organization.plan/status —
// a superadmin (product owner) manages every tenant's plan label and active/suspended state.
// Deliberately NOT wired to real billing/payments (still Phase 3) and NOT self-service — see DEVELOPER.md.
// Slice 21: OrgAiSettings / MomUpload / MomTaskCandidate — per-org "upload a MoM PDF, AI extracts
// action items into a review queue, accept/edit/reject before it becomes a real Task" pipeline.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TO_VERIFY
  FAILED
  DONE
}

// Per-assignee personal progress on a shared task — independent of the task's own status.
// Starting is one-shot-per-session but re-startable (NOT_STARTED -> IN_PROGRESS -> COMPLETED,
// and COMPLETED -> IN_PROGRESS again is allowed, to log more time in a later session).
enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  NEW_COMMENT
  TASK_DUE_SOON
  REOPEN_REQUESTED
  REOPEN_APPROVED
  REOPEN_REJECTED
  BLOCKER_REPORTED
  BLOCKER_RESOLVED
  TASK_VERIFICATION_REQUESTED
  TASK_VERIFIED
  TASK_SENT_BACK
  TASK_VERIFICATION_REJECTED
}

enum ReopenRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BlockerReportStatus {
  OPEN
  RESOLVED
}

enum OrganizationPlan {
  FREE
  PRO
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MomCandidateStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  plan      OrganizationPlan   @default(FREE)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())

  memberships       Membership[]
  clients           Client[]
  projects          Project[]
  tasks             Task[]
  notifications     Notification[]
  googleIntegration GoogleIntegration?
  orgAiSettings     OrgAiSettings?
  momUploads        MomUpload[]
  momTaskCandidates MomTaskCandidate[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  designation  String?
  initials     String
  avatarColor  String
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships            Membership[]
  refreshTokens          RefreshToken[]
  taskAssignments        TaskAssignment[]
  subtaskAssignments     Subtask[]           @relation("SubtaskAssignee")
  createdTasks           Task[]              @relation("TaskCreator")
  verifiedTasks          Task[]              @relation("TaskVerifier")
  comments               Comment[]
  attachments            Attachment[]
  taskActivities         TaskActivity[]
  timeEntries            TimeEntry[]
  notifications          Notification[]
  reopenRequestsMade     ReopenRequest[]     @relation("ReopenRequester")
  reopenRequestsHandled  ReopenRequest[]     @relation("ReopenReviewer")
  blockerReportsMade     BlockerReport[]     @relation("BlockerReporter")
  blockerReportsHandled  BlockerReport[]     @relation("BlockerResolver")
  googleIntegrations     GoogleIntegration[] @relation("GoogleIntegrationConnector")
  llmSettingsUpdates     LlmSettings[]
  orgAiSettingsUpdates   OrgAiSettings[]
  momUploads             MomUpload[]         @relation("MomUploader")
  momCandidatesSuggested MomTaskCandidate[]  @relation("MomSuggestedAssignee")
  momCandidatesReviewed  MomTaskCandidate[]  @relation("MomReviewer")

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// managerId is a self-reference to another Membership in the same org (not to a User directly)
// since "who manages whom" is an org-scoped fact, same as role/status — a person could in theory
// belong to multiple orgs with a different manager in each. Used to scope MANAGER-role visibility
// (tasks, dashboard, reports) to "themself + their direct reports" — see task-visibility.ts.
model Membership {
  id        String           @id @default(cuid())
  userId    String
  orgId     String
  role      Role             @default(USER)
  status    MembershipStatus @default(ACTIVE)
  managerId String?

  createdAt DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager       Membership?  @relation("MembershipManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Membership[] @relation("MembershipManager")

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([managerId])
  @@map("memberships")
}

model Client {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  website   String?
  location  String?
  poc       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects Project[]
  tasks    Task[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("clients")
}

model Project {
  id          String        @id @default(cuid())
  orgId       String
  clientId    String?
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks  Task[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([clientId])
  @@map("projects")
}

model Task {
  id          String       @id @default(cuid())
  orgId       String
  projectId   String?
  clientId    String?
  createdById String
  verifiedById String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client     Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy  User         @relation("TaskCreator", fields: [createdById], references: [id])
  verifiedBy User?        @relation("TaskVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  assignments    TaskAssignment[]
  subtasks       Subtask[]
  dependencies   TaskDependency[]  @relation("DependentTask")
  dependents     TaskDependency[]  @relation("BlockingTask")
  comments       Comment[]
  attachments    Attachment[]
  activities     TaskActivity[]
  timeEntries    TimeEntry[]
  notifications  Notification[]
  reopenRequests ReopenRequest[]
  blockerReports BlockerReport[]
  momCandidate   MomTaskCandidate?

  @@index([orgId])
  @@index([orgId, status])
  @@index([projectId])
  @@index([clientId])
  @@map("tasks")
}

// Slice 14: many-to-many task collaborators, replacing the old single Task.assigneeId.
// Every assignee has equal edit rights and gets notified the same way the sole assignee used to.
model TaskAssignment {
  id              String           @id @default(cuid())
  taskId          String
  userId          String
  status          AssignmentStatus @default(NOT_STARTED)
  activeStartedAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignments")
}

// Slice 15: Subtask.assigneeId — the individual owner doing that piece of work,
// so effort on a multi-assignee task is visible per person. Must be one of the
// parent Task's current assignees (see SubtasksService); purely informational,
// doesn't narrow who can toggle/edit the subtask (see task-permissions.ts).
model Subtask {
  id         String   @id @default(cuid())
  taskId     String
  assigneeId String?
  title      String
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User? @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([assigneeId])
  @@map("subtasks")
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([taskId])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  commentId    String?
  uploadedById String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([commentId])
  @@map("attachments")
}

enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
}

model TaskActivity {
  id        String           @id @default(cuid())
  taskId    String
  actorId   String
  type      TaskActivityType
  message   String
  createdAt DateTime         @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId])
  @@map("task_activities")
}

model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  minutes   Int
  note      String?
  date      DateTime
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("time_entries")
}

model Notification {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  taskId    String?
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([orgId])
  @@map("notifications")
}

model ReopenRequest {
  id            String              @id @default(cuid())
  taskId        String
  requestedById String
  reason        String
  status        ReopenRequestStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ReopenRequester", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("ReopenReviewer", fields: [reviewedById], references: [id])

  @@index([taskId])
  @@map("reopen_requests")
}

// Slice 16: a lightweight, trackable "I'm blocked" flag — free-text reason, not tied to a
// formal TaskDependency link. ADMIN/MANAGER are notified when one is raised and can resolve
// it; the reporter is notified back on resolution. Raisable by anyone with edit rights on the
// task (assertCanModifyTask), same as reopen requests.
model BlockerReport {
  id             String              @id @default(cuid())
  taskId         String
  reportedById   String
  reason         String
  status         BlockerReportStatus @default(OPEN)
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reportedBy User  @relation("BlockerReporter", fields: [reportedById], references: [id])
  resolvedBy User? @relation("BlockerResolver", fields: [resolvedById], references: [id])

  @@index([taskId])
  @@map("blocker_reports")
}

// Slice 19: one Google Workspace connection per org, used to pull Google Meet transcripts.
// refreshTokenEncrypted is a real secret (unlike RefreshToken's hashed tokens — this one has to
// be decrypted and reused to call Google's API later), so it's AES-256-GCM encrypted at rest via
// TOKEN_ENCRYPTION_KEY, never stored or logged in plaintext. See common/utils/encryption.ts.
model GoogleIntegration {
  id                    String    @id @default(cuid())
  orgId                 String    @unique
  googleEmail           String
  refreshTokenEncrypted String
  connectedById         String
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectedBy User         @relation("GoogleIntegrationConnector", fields: [connectedById], references: [id])

  @@map("google_integrations")
}

// Slice 20: one platform-wide LLM API key (a single fixed-id row acts as a singleton), not
// per-org — meeting-note summarization is a shared cost the platform bears, the same category
// as SMTP_HOST being one server-wide setting today, not something each tenant configures. Managed
// by a superadmin from /admin, not a tenant's own ADMIN. apiKeyEncrypted uses the same
// AES-256-GCM/TOKEN_ENCRYPTION_KEY approach as GoogleIntegration's refresh token.
model LlmSettings {
  id              String   @id @default("default")
  apiKeyEncrypted String
  model           String   @default("claude-sonnet-5")
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User @relation(fields: [updatedById], references: [id])

  @@map("llm_settings")
}

// Slice 21: MoM (Minutes of Meeting) PDF upload → AI-extracted task queue.
// Unlike LlmSettings above, this key is per-org (each tenant brings their own Anthropic key and
// bears its own cost), managed by that org's own ADMIN from Settings, not a superadmin.
// Same AES-256-GCM/TOKEN_ENCRYPTION_KEY encryption-at-rest approach as the other secrets here.
model OrgAiSettings {
  id              String   @id @default(cuid())
  orgId           String   @unique
  apiKeyEncrypted String
  model           String   @default("claude-sonnet-5")
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedBy User         @relation(fields: [updatedById], references: [id])

  @@map("org_ai_settings")
}

// One row per uploaded MoM PDF. The extraction result (one row per action item found) lives in
// MomTaskCandidate below — kept separate so a single upload can produce many review-queue items.
model MomUpload {
  id           String   @id @default(cuid())
  orgId        String
  uploadedById String
  fileName     String
  storageKey   String
  sizeBytes    Int
  itemsFound   Int
  itemsNew     Int
  createdAt    DateTime @default(now())

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("MomUploader", fields: [uploadedById], references: [id])
  candidates MomTaskCandidate[]

  @@index([orgId])
  @@map("mom_uploads")
}

// A single AI-extracted action item awaiting human review. Accepting one creates a real Task
// (via TasksService, so it gets the same activity log/notifications as a manually-created task)
// and links back here via createdTaskId; rejecting just marks it REJECTED for audit. Only PENDING
// candidates are editable — this queue exists for MoM-sourced tasks only, not general task intake.
model MomTaskCandidate {
  id                    String             @id @default(cuid())
  orgId                 String
  momUploadId           String
  title                 String
  description           String
  suggestedAssigneeName String?
  suggestedAssigneeId   String?
  dueDate               DateTime?
  priority              TaskPriority       @default(MEDIUM)
  context               String?
  status                MomCandidateStatus @default(PENDING)
  createdTaskId         String?            @unique
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  momUpload         MomUpload    @relation(fields: [momUploadId], references: [id], onDelete: Cascade)
  suggestedAssignee User?        @relation("MomSuggestedAssignee", fields: [suggestedAssigneeId], references: [id], onDelete: SetNull)
  createdTask       Task?        @relation(fields: [createdTaskId], references: [id], onDelete: SetNull)
  reviewedBy        User?        @relation("MomReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([momUploadId])
  @@map("mom_task_candidates")
}
