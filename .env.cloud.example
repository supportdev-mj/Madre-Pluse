# Copy to .env.cloud and fill in real values, then:
#   docker compose -f docker-compose.cloud.yml --env-file .env.cloud up -d --build
#   docker compose -f docker-compose.cloud.yml --env-file .env.cloud exec api npx prisma migrate deploy

# Your server's public IP or domain (no https:// — used to build both http://SERVER_IP and
# http://SERVER_IP:4000 URLs). Update this and rebuild (`up -d --build`) if it ever changes.
SERVER_IP=203.0.113.10

POSTGRES_USER=madrepulse
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=madrepulse

# Generate each of these with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TOKEN_ENCRYPTION_KEY=

# File attachments need a real S3-compatible bucket with a *public* endpoint (presigned download
# URLs are fetched directly by the browser, never through the API). Leave these as placeholders
# if you don't have one yet — everything else works fine; only file uploads will fail until this
# is filled in with a real bucket (AWS S3, DigitalOcean Spaces, Cloudflare R2, etc.).
S3_ENDPOINT=http://storage-not-yet-configured.invalid
S3_PUBLIC_ENDPOINT=http://storage-not-yet-configured.invalid
S3_BUCKET=madrepulse-attachments
S3_ACCESS_KEY=madrepulse
S3_SECRET_KEY=change-me

# Optional — leave blank to skip. Email logs instead of sending, and the Google Meet integration
# just shows "not configured" until these are set. See docs/DEVELOPER.md for what each unlocks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@madrepulse.local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
